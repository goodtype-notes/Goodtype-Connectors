{
  "manifestVersion": 1,
  "requires": ["end-caps", "path-edit-v0"],
  "id": "connectors",
  "version": "0.2.1",
  "apiVersion": "goodtype-api 0.1",
  "target": "x86_64-pc-windows-msvc",
  "entrypoint": "goodtype-connectors.exe",
  "transport": "stdio-jsonrpc",
  "permissions": ["own-objects", "react-to-changes"],
  "tools": [
    {
      "id": "connect",
      "label": "tool-connect",
      "icon": {"paths": ["M3 5h5v5H3z", "M16 14h5v5h-5z", "M8 7.5h4.5v9H16"]},
      "kind": "connect",
      "snap": "ports",
      "stroke": true,
      "settings": ["routing", "arrow"]
    }
  ],
  "commands": [{"id": "change-routing", "label": "cmd-routing", "surface": "own-object", "pathEdit": {"choice": "routing", "snap": "ports"}}],
  "settings": [
    {
      "id": "routing",
      "label": "routing",
      "hint": "routing-hint",
      "type": "choice",
      "default": "orthogonal",
      "choices": [
        {"value": "straight", "label": "routing-straight", "icon": {"paths": ["M4 19 20 5"]}},
        {"value": "curved", "label": "routing-curved", "icon": {"paths": ["M4 19C15 19 9 5 20 5"]}},
        {"value": "orthogonal", "label": "routing-orthogonal", "icon": {"paths": ["M4 18h8V6h8"]}}
      ]
    },
    {
      "id": "arrow",
      "label": "arrow",
      "type": "choice",
      "default": "none",
      "choices": [
        {"value": "none", "label": "arrow-none", "icon": {"paths": ["M3 12h18"]}},
        {"value": "end", "label": "arrow-end", "icon": {"paths": ["M3 12h17M15 7l5 5-5 5"]}},
        {"value": "both", "label": "arrow-both", "icon": {"paths": ["M4 12h16M9 7l-5 5 5 5M15 7l5 5-5 5"]}}
      ]
    }
  ],
  "strings": {
    "en": {
      "name": "Connectors",
      "tool-connect": "Connect",
      "cmd-routing": "Change routing",
      "routing": "Routing",
      "routing-hint": "How a new connector runs between two parts",
      "routing-straight": "Straight",
      "routing-curved": "Curved",
      "routing-orthogonal": "Right-angled",
      "arrow": "Arrowheads",
      "arrow-none": "None",
      "arrow-end": "At the end",
      "arrow-both": "At both ends"
    },
    "de": {
      "name": "Verbinder",
      "tool-connect": "Verbinden",
      "cmd-routing": "Linienführung ändern",
      "routing": "Linienführung",
      "routing-hint": "Wie ein neuer Verbinder zwischen zwei Teilen verläuft",
      "routing-straight": "Gerade",
      "routing-curved": "Gebogen",
      "routing-orthogonal": "Rechtwinklig",
      "arrow": "Pfeilspitzen",
      "arrow-none": "Keine",
      "arrow-end": "Am Ende",
      "arrow-both": "An beiden Enden"
    }
  }
}
